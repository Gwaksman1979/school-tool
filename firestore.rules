rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if false;

      match /{subcollection}/{docId} {
        allow read, write: if true;
      }

      match /students/{studentId}/remarks/{remarkId} {
        allow read, write: if true;
      }
    }
  }
}
